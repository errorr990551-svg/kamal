# ----------------------------------------------------------------------
# Kamal Brand - Apache / LiteSpeed config (Hostinger)
# Serves prerendered HTML for every page so crawlers get full content,
# returns real 404s for unknown URLs, and enables compression + caching.
# ----------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /pages/404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Never rewrite the deploy extractor or the PHP contact API.
  RewriteRule ^deploy_extract\.php$ - [L]
  RewriteRule ^api/contact/?$ api/contact.php [L,QSA]

  # 2. Remove trailing slashes (e.g. /products/ -> /products) so each page has one URL.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 3. Real files (JS, CSS, images, sitemap, robots) are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Prerendered pages.
  RewriteRule ^(products|dealership|hampers|contract|about|contact)$ pages/$1.html [L]
  RewriteRule ^products/([a-z0-9-]+)$ pages/products/$1.html [L]

  # 5. Anything else that is not a real directory: 404 (served from /pages/404.html).
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/pages/
  RewriteRule ^.+$ - [R=404,L]
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Hashed build assets never change: cache forever.
  <FilesMatch "^.+-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML must always be revalidated so visitors get new content right after a deploy.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(deploy_extract\.php)$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>
